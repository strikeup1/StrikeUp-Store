# StrikeUp Store — environment configuration
# Copy to .env and adjust. All values are optional.

# Port the server listens on (default 8788).
PORT=8788

# Admin credentials (defaults: owner / StrikingUp@2026 dev credentials).
# ALWAYS set a strong password in production.
STRIKEUP_STORE_ADMIN_USER=owner
STRIKEUP_STORE_ADMIN_PASSWORD=change-me

# Where JSON data lives (default: ./backend/data).
# Use a persistent volume in container/Paas deployments.
STRIKEUP_STORE_DATA_DIR=./backend/data

# Where uploaded APKs/images live (default: ./backend/uploads).
STRIKEUP_STORE_UPLOADS_DIR=./backend/uploads