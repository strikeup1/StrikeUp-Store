{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "robots.txt",
          "assets/**",
          "0301560/**"
        ]
      }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "0301560/admin/index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/admin($|/.*)", "dest": "/__admin_blocked__" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}